{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "company",
  "main": "src/server/worker.ts",
  "compatibility_date": "2025-10-01",
  "build": { "command": "npm run build" },
  "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/ws/*", "/api/*"] },
  "durable_objects": {
    "bindings": [
      { "name": "DEPT", "class_name": "DeptRoom" },
      { "name": "BUILDING", "class_name": "BuildingRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["DeptRoom", "BuildingRoom"] }
  ],
  "observability": { "enabled": false }
}
